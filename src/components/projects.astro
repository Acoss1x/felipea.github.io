          </div>

          <div class="bg-white text-black rounded-2xl p-6 flex flex-col justify-between min-h-[230px]">
            <div>
              <h5 class="text-xl font-bold mb-2">Relacional Residuos</h5>
              <p class="text-sm text-gray-700 mb-6">
