          <div class="bg-white text-black rounded-2xl p-6 flex flex-col justify-between min-h-[230px]">
            <div>
              <h5 class="text-xl font-bold mb-2">MER-E Residuos</h5>
              <p class="text-sm text-gray-700 mb-6">
                Modelo MER-E para gestión de residuos.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/residuosOK.png`}
              download
              class="bg-black text-white text-center py-3 rounded-xl hover:scale-105 transition"
