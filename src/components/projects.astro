  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-7xl mx-auto px-6">

    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Mis</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Evidencias</h3>

    <div class="flex flex-col gap-8">

      <!-- MODELADO -->
      <div class="rounded-2xl border border-white/10 bg-[#141414] p-10">
        <h4 class="text-4xl font-semibold mb-10">Modelado</h4>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

          <!-- CARD -->
          <div class="bg-white text-black rounded-2xl p-6 flex flex-col justify-between min-h-[230px]">
            <div>
              <h5 class="text-xl font-bold mb-2">Modelo 1</h5>
              <p class="text-sm text-gray-700 mb-6">
                Primer modelo conceptual trabajado en clase, el cual trata de una aerolinea.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/Modelo1.png`}
              download
              class="bg-black text-white text-center py-3 rounded-xl hover:scale-105 transition"
            >
              Descargar
            </a>
          </div>

          <div class="bg-white text-black rounded-2xl p-6 flex flex-col justify-between min-h-[230px]">
            <div>
              <h5 class="text-xl font-bold mb-2">Modelo 2</h5>
