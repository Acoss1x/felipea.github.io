      <!-- SQL -->
      <div class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6">
        <h4 class="text-2xl font-semibold mb-6">SQL</h4>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

          <div class="bg-white text-black rounded-2xl p-6 flex flex-col justify-between min-h-[220px]">
            <div>
