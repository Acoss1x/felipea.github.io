              Descargar
            </a>
          </div>

          <div class="bg-white text-black rounded-2xl p-6 flex flex-col justify-between min-h-[230px]">
            <div>
              <h5 class="text-xl font-bold mb-2">Modelo 3</h5>
              <p class="text-sm text-gray-700 mb-6">
                Ejercicio avanzado de modelado de base de datos.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/Modelo3.png`}
