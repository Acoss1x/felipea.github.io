---
import { Image } from "astro:assets";
import svgl from "../../public/svgl.png";
import stockin from "../../public/stockin.png";
import moviesfordevs from "../../public/moviesfordevs.png";
import velez from "../../public/velez.png";
import modelo1 from "../../public/modelo1.drawio.png";
import modelo2 from "../../public/Avion.png";
import modelo3 from "../../public/biblioteca.png";


interface Project {
  title: string;
  image: ImageMetadata;
  link: string;
  preview: string;
  status: string;
}

const projects: Project[] = [
  {
    title: "MoviesForDevs",
    image: moviesfordevs as ImageMetadata,
    link: "https://github.com/gothsec/MoviesForDevs",
    preview: "https://movies-for-devs.vercel.app",
    status: "Deployed",
  },
  {
    title: "StockIn",
    image: stockin as ImageMetadata,
    link: "https://github.com/gothsec/stockin-demo",
    preview: "https://stockin-demo.vercel.app",
    status: "On Development",
  },
  {
    title: "Svgl.app",
    image: svgl as ImageMetadata,
    link: "https://github.com/pheralb/svgl",
    preview: "https://svgl.app",
    status: "Contributor",
  },
  {
    title: "Rifas Velez Web",
    image: velez as ImageMetadata,
    link: "https://github.com/Buga-Software/rifasvelez-web",
    preview: "https://www.rifasvelez.com",
    status: "Deployed",
  },
];
---

<section
  id="evidencias"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-7xl mx-auto px-6">

    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Mis</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Evidencias</h3>

    <div class="flex flex-col gap-8">

      <!-- MODELADO -->
      <div class="rounded-2xl border border-white/10 bg-[#141414] p-10">
        <h4 class="text-4xl font-semibold mb-10">Modelado</h4>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

          <!-- CARD -->
          <div class="bg-white text-black rounded-2xl p-5 flex flex-col justify-between gap-4 hover:scale-[1.02] transition">
            <div>
              <h5 class="text-xl font-semibold">Modelo 1</h5>
              <p class="text-sm text-gray-600">
                Primer ejercicio de modelado entidad relación.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/Modelo1.png`}
              download
              class="bg-black text-white text-center py-3 rounded-xl font-medium hover:bg-neutral-800 transition"
            >
              Descargar
            </a>
          </div>

          <!-- CARD -->
          <div class="bg-white text-black rounded-2xl p-5 flex flex-col justify-between gap-4 hover:scale-[1.02] transition">
            <div>
              <h5 class="text-xl font-semibold">Modelo 2</h5>
              <p class="text-sm text-gray-600">
                Modelo relacional del ejercicio de avión.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/Modelo2.png`}
              download
              class="bg-black text-white text-center py-3 rounded-xl font-medium hover:bg-neutral-800 transition"
            >
              Descargar
            </a>
          </div>

          <!-- CARD -->
          <div class="bg-white text-black rounded-2xl p-5 flex flex-col justify-between gap-4 hover:scale-[1.02] transition">
            <div>
              <h5 class="text-xl font-semibold">Modelo 3</h5>
              <p class="text-sm text-gray-600">
                Modelo MER de biblioteca.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/Modelo3.png`}
              download
              class="bg-black text-white text-center py-3 rounded-xl font-medium hover:bg-neutral-800 transition"
            >
              Descargar
            </a>
          </div>

          <!-- CARD -->
          <div class="bg-white text-black rounded-2xl p-5 flex flex-col justify-between gap-4 hover:scale-[1.02] transition">
            <div>
              <h5 class="text-xl font-semibold">Modelo 4</h5>
              <p class="text-sm text-gray-600">
                Ejercicio avanzado de modelado.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/Modelo4.png`}
              download
              class="bg-black text-white text-center py-3 rounded-xl font-medium hover:bg-neutral-800 transition"
            >
              Descargar
            </a>
          </div>

        </div>
      </div>

      <!-- NORMALIZACIÓN -->
      <div class="rounded-2xl border border-white/10 bg-[#141414] p-10">
        <h4 class="text-4xl font-semibold mb-10">Normalización</h4>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

          <div class="bg-white text-black rounded-2xl p-5 flex flex-col justify-between gap-4 hover:scale-[1.02] transition">
            <div>
              <h5 class="text-xl font-semibold">
                Ejercicios de Normalización
              </h5>

              <p class="text-sm text-gray-600">
                Taller de normalización realizado en Excel.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/Normalizacion.xlsx`}
              download
              class="bg-black text-white text-center py-3 rounded-xl font-medium hover:bg-neutral-800 transition"
            >
              Descargar
            </a>
          </div>

        </div>
      </div>

      <!-- ALGEBRA -->
      <div class="rounded-2xl border border-white/10 bg-[#141414] p-10">
        <h4 class="text-4xl font-semibold mb-10">Álgebra Relacional</h4>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

          <div class="bg-white text-black rounded-2xl p-5 flex flex-col justify-between gap-4 hover:scale-[1.02] transition">
            <div>
              <h5 class="text-xl font-semibold">
                Taller Álgebra Relacional
              </h5>

              <p class="text-sm text-gray-600">
                Consultas y ejercicios de álgebra relacional.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/algebrarelacional.pdf`}
              download
              class="bg-black text-white text-center py-3 rounded-xl font-medium hover:bg-neutral-800 transition"
            >
              Descargar
            </a>
          </div>

        </div>
      </div>

      <!-- SQL -->
      <div class="rounded-2xl border border-white/10 bg-[#141414] p-10">
        <h4 class="text-4xl font-semibold mb-10">SQL</h4>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

          <div class="bg-white text-black rounded-2xl p-5 flex flex-col justify-between gap-4 hover:scale-[1.02] transition">
            <div>
              <h5 class="text-xl font-semibold">
                SQL Crear Objetos
              </h5>

              <p class="text-sm text-gray-600">
                Script para creación de tablas y estructuras.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/01_crear_objetos.sql`}
              download
              class="bg-black text-white text-center py-3 rounded-xl font-medium hover:bg-neutral-800 transition"
            >
              Descargar
            </a>
          </div>

          <div class="bg-white text-black rounded-2xl p-5 flex flex-col justify-between gap-4 hover:scale-[1.02] transition">
            <div>
              <h5 class="text-xl font-semibold">
                SQL Insertar Registros
              </h5>

              <p class="text-sm text-gray-600">
                Inserción de registros para el sistema gimnasio.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/02_insertar_registros.sql`}
              download
              class="bg-black text-white text-center py-3 rounded-xl font-medium hover:bg-neutral-800 transition"
            >
              Descargar
            </a>
          </div>

          <div class="bg-white text-black rounded-2xl p-5 flex flex-col justify-between gap-4 hover:scale-[1.02] transition">
            <div>
              <h5 class="text-xl font-semibold">
                SQL Scripts Varios
              </h5>

              <p class="text-sm text-gray-600">
                Consultas y scripts complementarios.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/03_scripts_varios.sql`}
              download
              class="bg-black text-white text-center py-3 rounded-xl font-medium hover:bg-neutral-800 transition"
            >
              Descargar
            </a>
          </div>

        </div>
      </div>

      <!-- PROYECTO -->
      <div class="rounded-2xl border border-white/10 bg-[#141414] p-10">
        <h4 class="text-4xl font-semibold mb-10">Proyecto Final</h4>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

          <div class="bg-white text-black rounded-2xl p-5 flex flex-col justify-between gap-4 hover:scale-[1.02] transition">
            <div>
              <h5 class="text-xl font-semibold">
                MER-E Crow's Foot
              </h5>

              <p class="text-sm text-gray-600">
                Modelo entidad relación en notación Crow's Foot.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/crowsfootgimnasio.docx`}
              download
              class="bg-black text-white text-center py-3 rounded-xl font-medium hover:bg-neutral-800 transition"
            >
              Descargar
            </a>
          </div>

          <div class="bg-white text-black rounded-2xl p-5 flex flex-col justify-between gap-4 hover:scale-[1.02] transition">
            <div>
              <h5 class="text-xl font-semibold">
                MER-E Peter Chen
              </h5>

              <p class="text-sm text-gray-600">
                Modelo conceptual usando notación Peter Chen.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/meregimnasio.docx`}
              download
              class="bg-black text-white text-center py-3 rounded-xl font-medium hover:bg-neutral-800 transition"
            >
              Descargar
            </a>
          </div>

          <div class="bg-white text-black rounded-2xl p-5 flex flex-col justify-between gap-4 hover:scale-[1.02] transition">
            <div>
              <h5 class="text-xl font-semibold">
                Modelo Relacional
              </h5>

              <p class="text-sm text-gray-600">
                Modelo relacional final del proyecto gimnasio.
              </p>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}/relacionalgimnasio.dmd`}
              download
              class="bg-black text-white text-center py-3 rounded-xl font-medium hover:bg-neutral-800 transition"
            >
              Descargar
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

