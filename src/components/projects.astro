      </div>

      <!-- NORMALIZACION -->
      <div class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6">
        <h4 class="text-2xl font-semibold mb-6">Normalización</h4>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

